NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Must match identity-svc's own GOOGLE_CLIENT_ID (see backend-infra's
# docker-compose.yml) — Google verifies the ID token's aud claim against
# this same client, so a mismatch here silently breaks Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8087
NEXT_PUBLIC_CATALOG_API_BASE_URL=http://localhost:8089
NEXT_PUBLIC_INVENTORY_API_BASE_URL=http://localhost:8090
NEXT_PUBLIC_ENGAGEMENT_API_BASE_URL=http://localhost:8092
NEXT_PUBLIC_ORGANIZER_API_BASE_URL=http://localhost:8088
NEXT_PUBLIC_BOOKING_API_BASE_URL=http://localhost:8091
NEXT_PUBLIC_PAYMENTS_API_BASE_URL=http://localhost:8093
# Public base URL of the R2 bucket (enable the r2.dev subdomain or a custom domain on
# assets-of-organisers), e.g. https://pub-xxxx.r2.dev — without it, uploaded photos can't render.
NEXT_PUBLIC_MEDIA_BASE_URL=
